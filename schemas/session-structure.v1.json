{
  "$id": "https://github.com/Brondard/ObjectifIM/schemas/session-structure.v1.json",
  "title": "Structure d'une séance",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "warmup",
                  "work",
                  "recovery",
                  "cooldown",
                  "rest"
                ]
              },
              "duration_s": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "distance_m": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "intensity": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": [
                          "hr",
                          "pace",
                          "power",
                          "swim_pace"
                        ]
                      },
                      "zone": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      }
                    },
                    "required": [
                      "basis",
                      "zone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "basis": {
                        "type": "string",
                        "enum": [
                          "hr",
                          "pace",
                          "power",
                          "swim_pace",
                          "rpe"
                        ]
                      },
                      "min": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "max": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    },
                    "required": [
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "$ref": "#/$defs/__schema0"
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "repeat"
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "warmup",
                      "work",
                      "recovery",
                      "cooldown",
                      "rest"
                    ]
                  },
                  "duration_s": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "distance_m": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "intensity": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "enum": [
                              "hr",
                              "pace",
                              "power",
                              "swim_pace"
                            ]
                          },
                          "zone": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 7
                          }
                        },
                        "required": [
                          "basis",
                          "zone"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "enum": [
                              "hr",
                              "pace",
                              "power",
                              "swim_pace",
                              "rpe"
                            ]
                          },
                          "min": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "max": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "basis",
                          "min",
                          "max"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "times",
        "steps"
      ],
      "additionalProperties": false
    }
  }
}
