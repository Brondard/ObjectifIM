{
  "$id": "https://github.com/Brondard/ObjectifIM/schemas/plan-block.v1.json",
  "title": "Bloc d'entraînement à importer",
  "description": "Contrat d'import : un bloc couvre une période ; le réimporter remplace les séances prévues non réalisées de cette période.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "string",
      "const": "1"
    },
    "period": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "phase": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "base",
            "build",
            "specific",
            "taper",
            "recovery",
            "return"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "objectives": {
          "type": "string",
          "maxLength": 4000
        },
        "targets": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "date": {
            "type": "string"
          },
          "local_time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$"
          },
          "discipline": {
            "type": "string",
            "enum": [
              "swim",
              "bike",
              "run",
              "strength",
              "other"
            ]
          },
          "session_type": {
            "type": "string",
            "enum": [
              "endurance",
              "long",
              "recovery",
              "tempo",
              "threshold",
              "vo2",
              "short_reps",
              "race_pace",
              "technique",
              "strength_push",
              "strength_pull",
              "strength_legs",
              "strength_core",
              "race",
              "other"
            ]
          },
          "priority": {
            "default": "secondary",
            "type": "string",
            "enum": [
              "key",
              "secondary",
              "optional"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "duration_min": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1440
          },
          "distance_m": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "target_intensity": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": [
                      "hr",
                      "pace",
                      "power",
                      "swim_pace"
                    ]
                  },
                  "zone": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  }
                },
                "required": [
                  "basis",
                  "zone"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "basis": {
                    "type": "string",
                    "enum": [
                      "hr",
                      "pace",
                      "power",
                      "swim_pace",
                      "rpe"
                    ]
                  },
                  "min": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "max": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "basis",
                  "min",
                  "max"
                ]
              }
            ]
          },
          "structure": {
            "type": "object",
            "properties": {
              "version": {
                "type": "number",
                "const": 1
              },
              "steps": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "warmup",
                            "work",
                            "recovery",
                            "cooldown",
                            "rest"
                          ]
                        },
                        "duration_s": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "distance_m": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "intensity": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "basis": {
                                  "type": "string",
                                  "enum": [
                                    "hr",
                                    "pace",
                                    "power",
                                    "swim_pace"
                                  ]
                                },
                                "zone": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 7
                                }
                              },
                              "required": [
                                "basis",
                                "zone"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "basis": {
                                  "type": "string",
                                  "enum": [
                                    "hr",
                                    "pace",
                                    "power",
                                    "swim_pace",
                                    "rpe"
                                  ]
                                },
                                "min": {
                                  "type": "number",
                                  "exclusiveMinimum": 0
                                },
                                "max": {
                                  "type": "number",
                                  "exclusiveMinimum": 0
                                }
                              },
                              "required": [
                                "basis",
                                "min",
                                "max"
                              ]
                            }
                          ]
                        },
                        "note": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "$ref": "#/$defs/__schema0"
                    }
                  ]
                }
              }
            },
            "required": [
              "version",
              "steps"
            ]
          },
          "instructions": {
            "type": "string",
            "maxLength": 4000
          },
          "indoor": {
            "type": "boolean"
          }
        },
        "required": [
          "date",
          "discipline",
          "session_type"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "period",
    "sessions"
  ],
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "repeat"
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "steps": {
          "minItems": 1,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "warmup",
                      "work",
                      "recovery",
                      "cooldown",
                      "rest"
                    ]
                  },
                  "duration_s": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "distance_m": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "intensity": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "enum": [
                              "hr",
                              "pace",
                              "power",
                              "swim_pace"
                            ]
                          },
                          "zone": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 7
                          }
                        },
                        "required": [
                          "basis",
                          "zone"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "basis": {
                            "type": "string",
                            "enum": [
                              "hr",
                              "pace",
                              "power",
                              "swim_pace",
                              "rpe"
                            ]
                          },
                          "min": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "max": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "basis",
                          "min",
                          "max"
                        ]
                      }
                    ]
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "$ref": "#/$defs/__schema0"
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "times",
        "steps"
      ]
    }
  }
}
